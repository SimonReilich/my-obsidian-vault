filters:
  and:
    - file.tags.contains("Buch")
views:
  - type: cards
    name: View
    order:
      - title
      - author
      - publish
    image: note.localCover
    imageAspectRatio: 1.5
    imageFit: cover
    cardSize: 220
  - type: table
    name: Table
    order:
      - title
      - author
      - category
      - publish
    sort: []
    columnSize:
      note.title: 299
      note.author: 580
      note.category: 400
