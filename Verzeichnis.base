filters:
  and:
    - file.hasTag("Artikel")
views:
  - type: cards
    name: View
    order:
      - title
      - file.tags
      - author
      - publisher
      - year
      - note.file
    sort:
      - property: title
        direction: ASC
    cardSize: 350
    imageAspectRatio: 1
  - type: table
    name: Table
