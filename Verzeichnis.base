filters:
  and:
    - file.hasTag("Literatur")
views:
  - type: cards
    name: View
    order:
      - title
      - source
      - journal
      - authors
      - file.tags
      - publish
    sort:
      - property: publish
        direction: ASC
      - property: authors
        direction: ASC
    cardSize: 440
    imageAspectRatio: 1
  - type: table
    name: Table
