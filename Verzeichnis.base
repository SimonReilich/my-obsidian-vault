filters:
  and:
    - file.hasTag("Literatur")
    - file.folder.contains("Literatur")
views:
  - type: cards
    name: View
    order:
      - title
      - source
      - file.tags
      - author
      - publisher
      - year
    sort:
      - property: year
        direction: ASC
      - property: author
        direction: ASC
    cardSize: 350
    imageAspectRatio: 1
  - type: table
    name: Table
