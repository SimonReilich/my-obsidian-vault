filters:
  and:
    - file.tags.contains("Video")
views:
  - type: cards
    name: View
    order:
      - title
      - channel
      - links
    image: note.thumbnail
    imageAspectRatio: 0.5625
    imageFit: cover
    cardSize: 330
  - type: table
    name: Table
    order:
      - title
      - channel
      - publishDate
      - links
    sort: []
    columnSize:
      note.title: 299
      note.author: 580
      note.category: 400
