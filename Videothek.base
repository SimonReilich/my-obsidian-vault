filters:
  and:
    - file.tags.contains("Video")
    - file.name != "Video Vorlage"
views:
  - type: cards
    name: View
    order:
      - title
      - channel
      - links
    sort:
      - property: publishDate
        direction: ASC
      - property: channel
        direction: ASC
    image: note.thumbnail
    imageAspectRatio: 0.5625
    imageFit: cover
    cardSize: 300
  - type: table
    name: Table
    order:
      - title
      - channel
      - publishDate
      - links
    sort: []
    columnSize:
      note.title: 299
      note.author: 580
      note.category: 400
